# Supply credentials locally. Values are intentionally empty.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Named profiles are also supported:
GEMINI_API_KEY_RESEARCH=

# 1 selects GEMINI_API_KEY, 2 selects GEMINI_API_KEY_2, RESEARCH selects the named key.
# Leave unset to retain GOOGLE_API_KEY -> GEMINI_API_KEY legacy precedence.
GEMINI_ACTIVE_KEY=1

# Keep your existing GEMINI_MODEL value; no default model is changed by this template.
# Optional per-stage overrides, otherwise both inherit GEMINI_MODEL:
GEMINI_LABEL_MODEL=
GEMINI_AGGREGATION_MODEL=
