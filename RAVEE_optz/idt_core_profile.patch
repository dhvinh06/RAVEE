+namespace {
+	using IdtProfileClock = std::chrono::steady_clock;
+
+	double idtSecondsSince(IdtProfileClock::time_point start) {
+		return std::chrono::duration<double>(IdtProfileClock::now() - start).count();
+	}
+
+	class IdtBlockTimer {
+	public:
+		explicit IdtBlockTimer(double* seconds) : seconds_(seconds) {
+			if (seconds_) start_ = IdtProfileClock::now();
+		}
+		~IdtBlockTimer() { stop(); }
+
+		void stop() {
+			if (seconds_) {
+				*seconds_ += idtSecondsSince(start_);
+				seconds_ = nullptr;
+			}
+		}
+
+	private:
+		double* seconds_;
+		IdtProfileClock::time_point start_;
+	};
+
+	struct IdtCoreProfile {
+		int frames = 0;
+		bool measuring = false;
+		double core = 0, surf = 0, camera_match_warp = 0;
+		double raw_flow = 0, warped_flow = 0, flow_state = 0;
+		double tracking = 0, descriptor_image = 0, descriptor_track = 0;
+
+		double* slot(double& seconds) const {
+			return measuring ? &seconds : nullptr;
+		}
+
+		void report(int levels, double packing) const {
+			fprintf(stderr, "IDT_CORE_PROFILE {\"frames\":%d,\"levels\":%d,"
+				"\"core_seconds\":%.9f,\"surf_seconds\":%.9f,"
+				"\"camera_match_warp_seconds\":%.9f,\"flow_raw_seconds\":%.9f,"
+				"\"flow_warped_seconds\":%.9f,\"flow_state_seconds\":%.9f,"
+				"\"tracking_seconds\":%.9f,\"descriptor_seconds\":%.9f,"
+				"\"numpy_packing_seconds\":%.9f}\n",
+				frames, levels, core, surf, camera_match_warp, raw_flow, warped_flow,
+				flow_state, tracking - descriptor_track, descriptor_image + descriptor_track, packing);
+		}
+	};
+}
 
